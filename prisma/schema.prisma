// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CallStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  ANALYZING
  DONE
  FAILED
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  reps      Rep[]
  calls     Call[]
}

model Rep {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  calls     Call[]

  @@unique([companyId, name])
}

model Call {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  repId            String?
  rep              Rep?              @relation(fields: [repId], references: [id], onDelete: SetNull)
  originalName     String
  audioPath        String            @unique
  durationSec      Int?
  status           CallStatus        @default(UPLOADED)
  assemblyId       String?
  transcript       Json? // utterances: { i, speaker, startMs, endMs, text }
  agentSpeaker     String? // "A" or "B"
  category         String? // SALES | RETENTION | SERVICE | NOT_SCORABLE
  subtype          String? // scheduling, billing, voicemail, wrong_number...
  direction        String? // INBOUND | OUTBOUND | UNKNOWN
  repName          String? // name the rep introduced themselves with
  outcome          String? // BOOKED | NOT_BOOKED | SAVED | LOST | RESOLVED | UNRESOLVED
  outcomeReason    String?
  summary          String?
  details          Json? // pest type, service requested, follow-up, etc.
  coaching         Json? // { strengths, improvements }: Note = { text, utterance | null }
  score            Float? // percentage of points / maxPoints, one decimal, computed in code
  rubricSetId      String? // which rubric set produced the analysis
  rubricSet        RubricSet?        @relation(fields: [rubricSetId], references: [id], onDelete: SetNull)
  scorecard        String? // rubric callType that was used
  points           Int?
  maxPoints        Int?
  tier             String? // GOLD | GREEN | BELOW
  analysisProgress Json? // { stage: classifying | assessing, attempt }
  analysisWarnings Json? // string[]
  analysisRaw      Json? // { models, classification, assessment, attempts, usage }
  callDate         DateTime? // null until a real source provides it
  failedStage      String?
  errorDetail      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  criteria         CriterionResult[]
  policyViolations PolicyViolation[]

  @@index([status])
  @@index([companyId, createdAt])
  @@index([category, outcome])
  @@index([repName])
  @@index([rubricSetId])
}

model CriterionResult {
  id          String  @id @default(uuid())
  callId      String
  call        Call    @relation(fields: [callId], references: [id], onDelete: Cascade)
  criterionId String
  result      String // PASS | FAIL | NA
  rationale   String?
  quotes      Json? // Quote[]: { utterance, quote }
  source      String // MODEL | AUTO_PASS | EXCLUDED

  @@unique([callId, criterionId])
  @@index([criterionId, result])
}

model PolicyViolation {
  id          String @id @default(uuid())
  callId      String
  call        Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  policyIndex Int
  rule        String // copy of the rule text at flag time
  explanation String
  quotes      Json // Quote[]

  @@index([callId])
}

enum RubricStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Document {
  id          String   @id @default(uuid())
  fileName    String
  storagePath String   @unique // {id}.{ext} in the rubric-documents bucket
  mimeType    String
  createdAt   DateTime @default(now())
}

model RubricSet {
  id                String       @id @default(uuid())
  version           Int          @unique @default(autoincrement())
  status            RubricStatus @default(DRAFT)
  sourceDocumentIds String[]
  data              Json // save_rubric tool input: scorecards, policies, conflicts, placeholders
  createdAt         DateTime     @default(now())
  calls             Call[]

  @@index([status])
}
